generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MEMBER
}

enum BookingStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  CONFIRMED
  REJECTED
  EXPIRED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  SUBMITTED
  VERIFIED
  REJECTED
}

enum SlotStatus {
  AVAILABLE
  HELD
  BOOKED
  BLOCKED
}

enum PromoType {
  PERCENTAGE
  FIXED_AMOUNT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  paymentsReviewed Payment[]
  bookings     Booking[]
}

model Court {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  floorType   String
  hourlyRate  Decimal  @db.Decimal(12, 2)
  imageUrl    String?
  imagePublicId String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slots       CourtSlot[]
  bookingItems BookingItem[]
  priceRules   CourtPriceRule[]
}

model CourtPriceRule {
  id         String   @id @default(cuid())
  courtId    String
  dayOfWeek  Int?
  startsAt   String
  endsAt     String
  hourlyRate Decimal  @db.Decimal(12, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  court      Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([courtId, dayOfWeek, isActive])
}

model CourtSlot {
  id            String     @id @default(cuid())
  courtId       String
  startsAt      DateTime
  endsAt        DateTime
  status        SlotStatus @default(AVAILABLE)
  holdExpiresAt DateTime?
  blockedReason String?
  bookingId     String?
  court         Court      @relation(fields: [courtId], references: [id], onDelete: Cascade)
  booking       Booking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([courtId, startsAt])
  @@index([startsAt, status])
  @@index([bookingId])
}

model Booking {
  id             String        @id @default(cuid())
  code           String        @unique
  customerName   String
  customerPhone  String
  userId         String?
  notes          String?
  promoCode      String?
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  status         BookingStatus @default(PENDING_PAYMENT)
  paymentStatus  PaymentStatus @default(UNPAID)
  paymentDueAt   DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  slots           CourtSlot[]
  items           BookingItem[]
  payments        Payment[]
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([customerPhone])
  @@index([userId])
  @@index([status, paymentDueAt])
}

model Promo {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  type        PromoType
  value       Decimal   @db.Decimal(12, 2)
  minAmount   Decimal?  @db.Decimal(12, 2)
  maxDiscount Decimal?  @db.Decimal(12, 2)
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, startsAt, endsAt])
}

model BookingItem {
  id        String   @id @default(cuid())
  bookingId String
  courtId   String
  startsAt  DateTime
  endsAt    DateTime
  price     Decimal  @db.Decimal(12, 2)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  court     Court    @relation(fields: [courtId], references: [id])

  @@index([bookingId])
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String
  senderName    String
  amount        Decimal       @db.Decimal(12, 2)
  proofUrl      String
  proofPublicId String
  status        PaymentStatus @default(SUBMITTED)
  rejectionReason String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reviewedBy    User?         @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([bookingId, status])
}

model OperatingHour {
  id          String  @id @default(cuid())
  dayOfWeek   Int     @unique
  opensAt     String
  closesAt    String
  slotMinutes Int     @default(60)
  isOpen      Boolean @default(true)
}

model Setting {
  id                 Int      @id @default(1)
  venueName          String
  address            String
  adminWhatsapp      String
  bankName           String
  bankAccountNumber  String
  bankAccountHolder  String
  holdDurationMinutes Int     @default(15)
  updatedAt          DateTime @updatedAt
}
